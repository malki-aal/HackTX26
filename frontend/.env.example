# live    = the backend in ../backend (see backend/docs/FRONTEND.md)
# fixture = in-browser sample data, no backend needed (clearly labelled in the UI)
NEXT_PUBLIC_API_MODE=live
# No provider keys here; Gemini, SerpApi and Nessie keys live only in backend/.env.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Sign-in (optional; leave blank to run in explicit demo mode with role labels) ---
# Clerk development app: https://dashboard.clerk.com -> your app -> API keys.
# The publishable key is meant for the browser. The SECRET key is server-only: put it in .env.local,
# never in a NEXT_PUBLIC_ variable, and never paste it into chat.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Set to true on a live deployment to refuse to run without a sign-in provider.
NEXT_PUBLIC_REQUIRE_AUTH=false
# Clerk reports SDK usage from development instances; this switches it off.
CLERK_TELEMETRY_DISABLED=1

# Production (Vercel): set these four in the Vercel dashboard, never in a file. See docs/DEPLOYMENT.md.
#   NEXT_PUBLIC_API_MODE=live
#   NEXT_PUBLIC_API_BASE_URL=https://<hosted-backend>/api/v1
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY
