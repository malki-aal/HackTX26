# Copy to .env and fill in locally. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
DEMO_MODE=true
# live | fixtures
INTEGRATION_MODE=live
DATABASE_PATH=./var/runway.sqlite

# Google Gemini (AI Studio key). GOOGLE_GENERATIVE_AI_API_KEY is accepted as an alias; set only one.
GEMINI_API_KEY=
# Run `npm run check:gemini` to list models available to your key, then set one here.
GEMINI_MODEL=
# Pace agent model calls for rate-limited tiers (free tier: 5/min). 0 = no pacing.
GEMINI_MAX_RPM=4

SERPAPI_API_KEY=
# Per-call timeout and max concurrent SerpApi calls (search + product lookups share the limit).
SERPAPI_TIMEOUT_MS=20000
SERPAPI_MAX_CONCURRENCY=2

# Capital One Nessie sandbox. Key from your profile at https://prod.nessieisreal.com
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# Leave blank to use the ids written by `npm run seed:nessie`.
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=

MAX_SEARCH_CALLS_PER_RUN=3
MAX_AGENT_STEPS=14
MAX_RESEARCH_DURATION_MS=300000
OFFER_MAX_AGE_MINUTES=30
# Time zone for reading relative delivery dates ("Free delivery by Wed").
COMPANY_TIMEZONE=America/Chicago
# Optional delivery location for Google Shopping, e.g. "Austin, Texas, United States". Without it,
# Google's delivery dates are estimates for an unknown location and never confirm a hard deadline.
SHOPPING_LOCATION=

# Port for the internal eve agent process (loopback only).
AGENT_RUNTIME_PORT=8100
# Set to 1 when the agent was already built (the Docker image runs `eve build` at build time).
RUNWAY_SKIP_AGENT_BUILD=

# ---- Sign-in (Clerk, Google) ----
# live mode requires clerk; "demo" (fixed demo actors) is allowed only with INTEGRATION_MODE=fixtures.
AUTH_MODE=
# Server-only secret from the same Clerk application the frontend uses. Never put this in the frontend.
CLERK_SECRET_KEY=
# Optional PEM public key for networkless token verification.
CLERK_JWT_KEY=
# Frontend origins allowed to have issued session tokens (defaults to FRONTEND_ORIGINS).
CLERK_AUTHORIZED_PARTIES=
# Team-supplied allowlist of verified emails -> company and role. See config/access.example.json.
ACCESS_BOOTSTRAP_FILE=./config/access.json
# Same allowlist as one line of JSON, for hosts without secret files. When set it wins over the file.
# Example shape: {"companies":[{"id":"runway_team","name":"Runway team"}],"members":[{"email":"<google email>","role":"executive","company":"runway_team"}]}
ACCESS_BOOTSTRAP_JSON=
# Company that owns the configured Nessie account (its executives see budget, merchants, purchases).
ACCOUNT_COMPANY_ID=org_demo
